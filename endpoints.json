              "host": ["{{baseUrl}}"],
              "path": ["usuario"]
            }
          }
        },
        {
          "name": "Obtener usuario por email",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuario/email?email=usuario@email.com",
              "host": ["{{baseUrl}}"],
              "path": ["usuario", "email"],
              "query": [
                {
                  "key": "email",
                  "value": "usuario@email.com"
                }
              ]
            }
          }
        },
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Perez\",\n  \"edad\": 30,\n  \"fechanacimiento\": \"1996-01-29\",\n  \"email\": \"juan@email.com\",\n  \"password\": \"1234567891011\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/usuario",
              "host": ["{{baseUrl}}"],
              "path": ["usuario"]
            }
          }
        },
        {
