          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Actualizado\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/usuario/{{usuarioId}}",
              "host": ["{{baseUrl}}"],
              "path": ["usuario", "{{usuarioId}}"]
            }
          }
        },
        {
